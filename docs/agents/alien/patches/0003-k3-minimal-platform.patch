+    . = BASE_ADDRESS;
+    skernel = .;
+
+    .text : ALIGN(4096){
+        __executable_start = .;
+        stext = .;
+        *(.text.entry)
+        . = ALIGN(4K);
+        strampoline = . ;
+        *(.text.trampoline)
+        . = ALIGN(4K);
+        etrampoline = . ;
+        *(.text.startup)
+        *(.text .text.*)
+        . = ALIGN(4K);
+        etext = .;
+        __etext = .;
+    }
+
+    .rodata : ALIGN(4096){
+        srodata = .;
+        *(.rodata .rodata.*)
+        *(.srodata .srodata.*)
+        *(.gcc_except_table .gcc_except_table.*)
+        . = ALIGN(4K);
+        erodata = .;
+    }
+
+    .data : ALIGN(4096){
+        sdata = .;
+        sinit = .;
+        *(.init_array .init_array.*)
+        einit = .;
+        *(.data .data.*)
+        *(.sdata .sdata.*)
+        . = ALIGN(4K);
+        edata = .;
+    }
+
+    .bss :  ALIGN(4096){
+        *(.bss.stack)
+        . = ALIGN(4K);
+        sbss = .;
+        *(.bss .bss.*)
